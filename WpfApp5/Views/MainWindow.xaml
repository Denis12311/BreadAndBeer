<Window x:Class="WpfApp5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp5"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <local:PlayerStatsControl HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" DataContext="{Binding CurrentPlayer}" />

        <!-- Карточки внизу по центру -->
        <ItemsControl ItemsSource="{Binding Hand}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.UseCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Margin="10,0">
                        <StackPanel>
                            <Image Source="{Binding ImagePath}" Width="100" Height="80" Stretch="Uniform" />
                            <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--Player Info-->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <StackPanel Margin="0,5,5,5">
                <TextBlock Text="{Binding CurrentPlayer.Name}"
                           Width="150" Height="50"
                           FontSize="20" FontWeight="Bold" 
                           HorizontalAlignment="Center" VerticalAlignment="Top" />
            </StackPanel>
            <StackPanel Margin="0,5,5,5">
                <TextBlock Text="{Binding CurrentSeason}"
                           Width="150" Height="50"
                           FontSize="20" FontWeight="Bold" />
            </StackPanel>
            <StackPanel Margin="0,5,5,5">
                <TextBlock Text="Цикл: "
                           Width="150" Height="25"
                           FontSize="20" FontWeight="Bold" />
                <TextBlock Text="{Binding Turns}"
                           Width="150" Height="50"
                           FontSize="20" FontWeight="Bold" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
